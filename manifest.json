{
  "manifest_version": 3,
  "name": "求职简历助手",
  "version": "0.11.0",
  "description": "校招简历自动填充（44 字段，覆盖 Moka/快手/飞书招聘/京东校招等主流招聘系统）、简历 PDF 一键导入、简历版本管理、投递记录与 CSV 导出。简历数据默认保存在浏览器本地。",
  "minimum_chrome_version": "116",
  "action": {
    "default_popup": "popup.html",
    "default_title": "求职简历助手"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "打开求职简历助手弹窗"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "field-dictionary.js",
        "lib/option-match.js",
        "lib/date-value.js",
        "lib/date-group.js",
        "site-adapters.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
