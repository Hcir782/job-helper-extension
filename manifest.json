{
  "manifest_version": 3,
  "name": "求职简历助手",
  "version": "0.1.0",
  "description": "中文简历自动填充、简历版本管理、投递记录管理与 CSV 导出。数据全部保存在浏览器本地，不上传云端。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "求职简历助手"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://www.liepin.com/*",
        "https://www.zhaopin.com/*",
        "https://www.51job.com/*",
        "https://www.lagou.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
